# Copy to .env and fill in values for live grounded explanations.
# Without OPENROUTER_API_KEY, GuardScan uses deterministic mock explanations.

OPENROUTER_API_KEY=

# Zero-cost model (no credit card required).
# Free tier limits: 20 requests/minute, 50 requests/day.
# Browse current free models: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Backups if the above is unavailable or rate-limited (429):
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
#
# "openrouter/free" routes to a randomly chosen free model. It survives model
# retirements, but its pool includes narrow models (e.g. a content-safety
# classifier), so explanation quality varies between requests.
# OPENROUTER_MODEL=openrouter/free

# Paid alternative (requires account credits):
# OPENROUTER_MODEL=openai/gpt-4o-mini
